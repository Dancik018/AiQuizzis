AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Free-tier alternative: set AI_PROVIDER=gemini and add a Google AI Studio key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional spacing between batch starts. Default: Gemini 13000, OpenAI 2000.
AI_REQUEST_INTERVAL_MS=
# Scanned PDF OCR runs free in the browser; no OCR API key is required.
# Batches are capped server-side; browser default is 10.
AI_BATCH_SIZE=10

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
QUIZ_BATCH_SIZE=50
QUIZ_CONCURRENCY=5
QUIZ_MIN_READY_QUESTIONS=20
# Optional fallback credentials; never put real secrets in this example.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Normally leave blank; OpenAI runs a rolling pool, free fallbacks stay paced.
AI_REQUEST_INTERVAL_MS=

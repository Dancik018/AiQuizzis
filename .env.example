OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
QUIZ_BATCH_SIZE=50
QUIZ_CONCURRENCY=5
QUIZ_MIN_READY_QUESTIONS=20
QUIZ_GENERATION_BATCH_SIZE=16

# Per-instance/IP application guard; OpenAI quotas still apply.
QUIZ_API_REQUESTS_PER_MINUTE=90

# Accounts: Supabase project public connection (never service_role here)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_URL=https://ai-quizzis.vercel.app
GOOGLE_AUTH_ENABLED=false
# Enable only after custom SMTP is configured and verified
EMAIL_AUTH_ENABLED=false

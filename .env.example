# Recommended free provider. Omit AI_PROVIDER to prefer configured Groq, then Gemini.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional free fallback for solving.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional explicitly selected paid provider.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Normally leave blank: Groq 55000, Gemini 13000, OpenAI 2000 ms.
AI_REQUEST_INTERVAL_MS=
# PDF/DOCX use adaptive token-budget batches (up to 40), not a fixed question count.
# Scanned PDF OCR runs free in the browser; no OCR API key is required.
